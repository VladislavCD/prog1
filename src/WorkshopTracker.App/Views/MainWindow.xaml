<Window x:Class="WorkshopTracker.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Состояние изделий цеха 43" Width="1280" Height="780" Background="#F8FAFC">
  <Grid Margin="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
    <Border Background="#0F172A" CornerRadius="18" Padding="20">
      <StackPanel>
        <TextBlock Text="Цех 43" Foreground="White" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Excel → SQLite → анализ" Foreground="#CBD5E1" Margin="0,6,0,28"/>
        <Button Content="Все изделия" Margin="0,4" Padding="12"/>
        <Button Content="Изменились сегодня" Margin="0,4" Padding="12"/>
        <Button Content="Требуют проверки" Margin="0,4" Padding="12"/>
        <Button Content="Журнал импорта" Margin="0,4" Padding="12"/>
      </StackPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
      <TextBlock Text="Состояние изделий цеха 43" FontSize="32" FontWeight="Bold" Foreground="#111827"/>
      <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,18">
        <TextBox Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="14" ToolTip="Путь к .xlsx"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Безопасно импортировать Excel" Padding="16,10" Click="Import_Click"/><TextBlock Text="{Binding Status}" Margin="16,9,0,0" Foreground="#475569"/></StackPanel>
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="16" Margin="0,14,0,0" ToolTip="Поиск по изделию, зав. №, н/з, договору, статусу" TextChanged="Search_TextChanged"/>
      </StackPanel>
      <DataGrid x:Name="ProductsGrid" Grid.Row="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Изделие" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="*"/><DataGridTextColumn Header="Зав. №" Binding="{Binding SerialNumber}" Width="*"/><DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="2*"/><DataGridTextColumn Header="Лист" Binding="{Binding Source.SheetName}" Width="80"/>
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid Grid.Row="3" ItemsSource="{Binding Issues}" AutoGenerateColumns="True" IsReadOnly="True" Margin="0,16,0,0"/>
    </Grid>
    <Border Grid.Column="2" Background="White" CornerRadius="18" Padding="22">
      <StackPanel DataContext="{Binding SelectedProduct}">
        <TextBlock Text="Карточка изделия" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0"/>
        <TextBlock Text="{Binding Designation}" Foreground="#64748B"/>
        <Separator Margin="0,16"/>
        <TextBlock Text="Заводской номер" Foreground="#64748B"/><TextBlock Text="{Binding SerialNumber}" FontSize="16"/>
        <TextBlock Text="Текущее состояние" Foreground="#64748B" Margin="0,12,0,0"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="16"/>
        <TextBlock Text="Источник Excel" Foreground="#64748B" Margin="0,12,0,0"/><TextBlock Text="{Binding Source.SheetName, StringFormat=Лист {0}}"/><TextBlock Text="{Binding Source.RowNumber, StringFormat=Строка {0}}"/><TextBlock Text="{Binding Source.CellRange}"/>
        <TextBlock Text="Уверенность" Foreground="#64748B" Margin="0,12,0,0"/><TextBlock Text="{Binding Confidence}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
